figNAME: 'outputs/jetphi.pdf'
upperpad:
  xLABEL: ''
  yLABEL: 'Entries'
  yRANGE:
    - 1e-0
    - 2e5
  ySCALE: linear
  plotables:
    - type: TH1F
      objname: data_jetphi
      file: /Users/noises/Downloads/output.root
      label: data
      plotstyle: data0
      legorder: -1
    # the foramt is controlled in each DrawObj.py
    - type: TH1F
      objname: sign_jetphi
      file: /Users/noises/Downloads/output.root
      label: Z+jet
      plotstyle: hist1
      legorder: 0
lowerpad:
  xLABEL: '$\phi^{jet}$'
  yLABEL: 'data / MC'
  yRANGE:
    -   0.1
    -   1.3
  # the foramt is controlled in each DrawObj.py
  plotables:
    - type: TGraphAsymmError
      objname: ratio_jetphi
      file: /Users/noises/Downloads/output.root
      label: 'original'
      plotstyle: data
